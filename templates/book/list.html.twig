<h1>liste des livres</h1>

<table border="1">
    
        <tr>
            <th>Titre</th>
            <th>Date de publication</th>
            <th>Publié</th>
            <th>Catégorie</th>
            <th>Auteur (username)</th>
        </tr>
    
    
        {% for book in books %}
            <tr>
                <td>{{ book.title }}</td>
                <td>{{ book.publicationDate ? book.publicationDate|date('d/m/Y') : '' }}</td>
                <td>{{ book.isPublished() ? 1 : 0 }}</td>

                <td>{{ book.category }}</td>
                <td>{{ book.author ? book.author.username : 'N/A' }}</td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5" class="text-center">Aucun livre trouvé</td>
            </tr>
        {% endfor %}
  
</table>
{% if publishedCount is defined and unpublishedCount is defined %}
  <h2>Statistiques des livres</h2>
  <p>Nombre de livres publiés : {{ publishedCount }}</p>
  <p>Nombre de livres non publiés : {{ unpublishedCount }}</p>
{% endif %}